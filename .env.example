# ==============================================================================
# Nexora AI — Single Source Env Template (Option 1) — 1 file for all env
# Copy: cp .env.example apps/backend/.env  (backend)
#       cp .env.example apps/frontend/.env.local  (frontend needs only NEXT_PUBLIC_API_URL)
# Deploy: Render/Vercel dashboards me same keys set karo, file push nai karvu
# ==============================================================================

# --- App ---
APP_NAME=Nexora AI
APP_VERSION=1.0.0
DEBUG=True
APP_MODE=PERSONAL  # PERSONAL | TEAM | ENTERPRISE
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_HEX_32  # openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Admin (first superuser) ---
ADMIN_EMAIL=admin@nexora.ai
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Database (Supabase Postgres) ---
# Local fallback: sqlite:///./nexora_ai.db
# Supabase Pooler (RECOMMENDED for Render - fixes Network unreachable).
# NEVER commit real passwords — copy the pooler URL from Supabase Dashboard
# -> Connect -> Transaction pooler and fill in [YOUR-PASSWORD] locally only.
# Deploy: set DATABASE_URL in the Render dashboard, never in git.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# --- AI Provider (CHAT = HuggingFace server, no local download) ---
AI_PROVIDER=huggingface  # huggingface | gemini (copilot) | mock
HF_TOKEN=hf_YOUR_HF_READ_TOKEN_HERE
NEXORA_MODEL_ID=vishvam26/nexora-qwen3.5-4b-merged  # public HF repo
NEXORA_MAX_NEW_TOKENS=512
NEXORA_TEMPERATURE=0.7
NEXORA_TOP_P=0.9
HF_HOME=D:\Nexora-AI\.cache\huggingface

# --- Gemini Copilot (Email/Python agents) ---
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE  # aistudio.google.com (AQ. key)
GEMINI_MODEL=gemini-2.5-flash  # 1.5 not found for AQ keys, 2.5-flash available

# --- Qdrant Vector DB (Cloud) ---
QDRANT_URL=https://YOUR_CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION=nexora_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Next.js Frontend (Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Prod Vercel: https://YOUR_RENDER_BACKEND.onrender.com/api/v1
# Local ngrok: https://YOUR_NGROK.ngrok-free.dev

# --- RAG / Memory ---
RAG_TOP_K=10
MAX_CONTEXT_TOKENS=4000
SIMILARITY_THRESHOLD=0.1
ENABLE_RERANKING=true
HYBRID_VECTOR_WEIGHT=0.70
HYBRID_KEYWORD_WEIGHT=0.30
GRAPH_MAX_DEPTH=2
CONFIDENCE_THRESHOLD=0.50
MAX_HISTORY_MESSAGES=10
SUMMARY_TRIGGER=20

# --- Email (SMTP, optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@nexora.ai

# --- Legacy / Optional (keep empty for free tier) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
NEXORA_BASE_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
NEXORA_DEVICE=auto
SENTRY_DSN=
ENABLE_PROMETHEUS=true
